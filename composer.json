{
    "name": "ages/backend",
    "description": "API Backend AGES — Gestion Académie",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php vendor/bin/phpunit --testsuite Unitaires",
        "test:integration": "@php vendor/bin/phpunit --testsuite Integration"
    }
}
